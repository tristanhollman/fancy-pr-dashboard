{
  "name": "fancy-pr-dashboard",
  "type": "module",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "react-devtools-core": "file:./stubs/react-devtools-core"
  },
  "description": "Terminal dashboard for open Azure DevOps pull requests.",
  "version": "0.0.0",
  "bin": {
    "fpr": "./src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "test": "bun test",
    "build": "bun build --compile --target=bun-windows-x64 ./src/index.tsx --outfile fpr.exe",
    "typecheck": "bunx tsc --noEmit"
  }
