{
  "name": "fancy-pr-dashboard",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Terminal dashboard for open Azure DevOps pull requests.",
  "version": "1.0.0",
  "engines": {
    "bun": ">=1.3.11"
  },
  "bin": {
    "fpr": "./src/index.tsx"
  },
  "files": [
    "src",
    "stubs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "file:./stubs/react-devtools-core"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "test": "bun test ./src",
    "build": "bun build --compile ./src/index.tsx --outfile fpr",
    "build:windows": "bun build --compile --target=bun-windows-x64 ./src/index.tsx --outfile fpr.exe",
    "build:linux": "bun build --compile --target=bun-linux-x64 ./src/index.tsx --outfile fpr-linux-x64",
    "typecheck": "bun run --bun tsc --noEmit --project scripts/tsconfig.json",
    "release:build": "bun run scripts/build-release.ts"
  }
}
